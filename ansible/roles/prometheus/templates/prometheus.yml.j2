global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_evaluation_interval }}

rule_files:
  - /etc/prometheus/rules/alerts.yml

scrape_configs:
  - job_name: node
    static_configs:
      - targets:
          - "127.0.0.1:{{ node_exporter_port }}"
        labels:
          instance: g3-monitor

      - targets:
          - "{{ client_private_ip }}:{{ node_exporter_port }}"
        labels:
          instance: g3-client

  - job_name: prometheus
    static_configs:
      - targets:
          - "127.0.0.1:{{ prometheus_port }}"
